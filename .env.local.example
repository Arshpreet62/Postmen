# MongoDB connection string
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/postman-clone?retryWrites=true&w=majority

# Signs session tokens. Required: the server refuses to sign or check tokens
# without it. Use a long random value, for example: openssl rand -base64 48
JWT_SECRET=

# Google sign-in (optional). The browser needs the NEXT_PUBLIC_ one; the
# server uses GOOGLE_CLIENT_ID and falls back to the public one.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# Public address of the site, used for the sitemap and social previews.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Postmen refuses to send requests to private and internal addresses
# (localhost, 10.x, 192.168.x, cloud metadata). Set this to true only when
# Postmen runs on your own machine and you want to test local APIs.
ALLOW_PRIVATE_ADDRESSES=false
